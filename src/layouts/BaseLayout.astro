---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import SmoothScroll from '../components/SmoothScroll.astro';
import { site } from '../config/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
}

const { title = site.name, description = site.description, type = 'website' } = Astro.props;
const pageTitle = title === site.name ? title : `${title} · ${site.name}`;
const canonicalUrl = new URL(Astro.url.pathname, site.url).toString();
---

<!doctype html>
<html lang={site.locale} data-theme="system">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#fcfcfb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141512" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={site.locale} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <script is:inline>
      (() => {
        try {
          const savedTheme = localStorage.getItem('theme-preference');
          const theme = ['light', 'dark', 'system'].includes(savedTheme) ? savedTheme : 'system';
          document.documentElement.dataset.theme = theme;
        } catch {
          document.documentElement.dataset.theme = 'system';
        }
      })();
    </script>
    <script is:inline>
      (() => {
        try {
          const savedLanguage = localStorage.getItem('language-preference');
          const language = savedLanguage === 'zh' || savedLanguage === 'en'
            ? savedLanguage
            : navigator.language.toLowerCase().startsWith('zh') ? 'zh' : 'en';
          document.documentElement.dataset.language = language;
          document.documentElement.lang = language === 'zh' ? 'zh-CN' : 'en';
        } catch {
          document.documentElement.dataset.language = 'en';
        }
      })();
    </script>
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content" tabindex="-1"><slot /></main>
    <Footer />
    <SmoothScroll />
    <ScrollReveal />
  </body>
</html>
