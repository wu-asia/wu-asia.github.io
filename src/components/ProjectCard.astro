---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  index?: number;
}

const { project, index } = Astro.props;
const number = index === undefined ? undefined : String(index + 1).padStart(2, '0');
---

<article class="project-card" data-reveal style={`--reveal-delay: ${index === undefined ? 0 : index * 70}ms`}>
  <div class="project-card-heading">
    {number && <span class="project-number">{number}</span>}
    <div>
      <div class="project-title-row">
        <h3 data-translate-en={project.name} data-translate-zh={project.nameZh}>{project.name}</h3>
        <span class:list={['status', `status-${project.status.toLowerCase().replace(' ', '-')}`]} data-i18n={project.status === 'Planned' ? 'planned' : project.status === 'In Progress' ? 'inProgress' : 'complete'}>{project.status}</span>
      </div>
      <p data-translate-en={project.description} data-translate-zh={project.descriptionZh}>{project.description}</p>
    </div>
  </div>
  <ul class="tag-list" aria-label={`${project.name} technologies`}>
    {project.technologies.map((technology) => <li>{technology}</li>)}
  </ul>
  <div class="project-links">
    <a href={project.github} target="_blank" rel="noreferrer"><span data-i18n="github">GitHub</span> <span aria-hidden="true">↗</span></a>
    {project.demo && <a href={project.demo} target="_blank" rel="noreferrer"><span data-i18n="demo">Demo</span> <span aria-hidden="true">↗</span></a>}
  </div>
</article>
