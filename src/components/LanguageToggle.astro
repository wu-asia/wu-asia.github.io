<button class="language-toggle" type="button" data-language-toggle aria-label="Switch language">
  <span aria-hidden="true">文</span>
  <span data-language-label>中文</span>
</button>

<script>
  import { copy, type Language } from '../config/i18n';

  const languages = ['en', 'zh'] as const;
  const toggle = document.querySelector<HTMLButtonElement>('[data-language-toggle]');
  const label = document.querySelector<HTMLElement>('[data-language-label]');

  function localizeDates(language: Language) {
    document.querySelectorAll<HTMLElement>('[data-localized-date]').forEach((element) => {
      const date = new Date(element.dataset.localizedDate ?? '');
      element.textContent = new Intl.DateTimeFormat(language === 'zh' ? 'zh-CN' : 'en', {
        year: 'numeric', month: 'short', day: 'numeric',
      }).format(date);
    });
  }

  function setLanguage(language: Language, persist = true) {
    const dictionary = copy[language];
    document.documentElement.dataset.language = language;
    document.documentElement.lang = language === 'zh' ? 'zh-CN' : 'en';
    document.querySelectorAll<HTMLElement>('[data-i18n]').forEach((element) => {
      const key = element.dataset.i18n as keyof typeof dictionary;
      if (key in dictionary) element.textContent = dictionary[key];
    });
    document.querySelectorAll<HTMLElement>('[data-translate-en][data-translate-zh]').forEach((element) => {
      element.textContent = language === 'zh' ? element.dataset.translateZh ?? '' : element.dataset.translateEn ?? '';
    });
    localizeDates(language);
    if (label) label.textContent = dictionary.languageSwitch;
    toggle?.setAttribute('aria-label', `Switch language to ${dictionary.languageSwitch}`);
    if (persist) {
      try { localStorage.setItem('language-preference', language); } catch { /* Storage is optional. */ }
    }
  }

  const saved = document.documentElement.dataset.language;
  const initial = languages.includes(saved as Language) ? saved as Language : 'en';
  setLanguage(initial, false);
  toggle?.addEventListener('click', () => setLanguage(document.documentElement.dataset.language === 'en' ? 'zh' : 'en'));
</script>
