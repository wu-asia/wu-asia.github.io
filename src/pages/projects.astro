---
import ProjectCard from '../components/ProjectCard.astro';
import { site } from '../config/site';
import { projects } from '../data/projects';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Projects" description={`Selected projects by ${site.name}.`}>
  <section class="page-hero container">
    <p class="eyebrow" data-i18n="projectsEyebrow">Projects</p>
    <h1 data-i18n="projectsHeading">Selected work.</h1>
    <p data-i18n="projectsDescription">A growing collection of technical explorations and software projects.</p>
  </section>

  <section class="section container project-page-section" data-reveal>
    <div class="project-grid">
      {projects.map((project, index) => <ProjectCard project={project} index={index} />)}
    </div>
  </section>
</BaseLayout>
