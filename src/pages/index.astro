---
import { exploring, githubUrl, site, techStack } from '../config/site';
import { getCollection } from 'astro:content';
import ProjectCard from '../components/ProjectCard.astro';
import HeroVisual from '../components/HeroVisual.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { projects } from '../data/projects';
import BaseLayout from '../layouts/BaseLayout.astro';
const featuredProjects = projects.filter((project) => project.featured);
const latestPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);
---

<BaseLayout title={site.name} description={site.introduction}>
  <section class="hero container" id="top">
    <div class="hero-copy">
      <p class="eyebrow hero-eyebrow" data-i18n="heroEyebrow">Computer Science · 2026</p>
      <h1 data-translate-en={site.name} data-translate-zh={site.nameZh}>{site.name}</h1>
      <p class="hero-role" data-translate-en={site.role} data-translate-zh={site.roleZh}>{site.role}</p>
      <p class="hero-introduction" data-translate-en={site.introduction} data-translate-zh={site.introductionZh}>{site.introduction}</p>
      <div class="hero-actions">
        <a class="button button-primary" href="#projects"><span data-i18n="viewProjects">View Projects</span> <span aria-hidden="true">↓</span></a>
        <a class="button button-secondary" href={githubUrl} target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <HeroVisual />
  </section>

  <section id="about" class="section container about-section" data-reveal>
    <SectionHeading index="01" label="About me" labelKey="aboutLabel" />
    <div class="section-content about-content">
      <h2 data-i18n="aboutHeading">A learner drawn to the systems behind intelligent software.</h2>
      <p data-translate-en={site.bio} data-translate-zh={site.bioZh}>{site.bio}</p>
    </div>
  </section>

  <section class="section container exploring-section" data-reveal>
    <SectionHeading index="02" label="Currently exploring" labelKey="exploringLabel" />
    <div class="section-content">
      <ul class="exploring-list">
        {exploring.map((item, index) => <li><span>{String(index + 1).padStart(2, '0')}</span><b data-translate-en={item.en} data-translate-zh={item.zh}>{item.en}</b></li>)}
      </ul>
    </div>
  </section>

  <section id="projects" class="section container projects-section" data-reveal>
    <SectionHeading index="03" label="Featured projects" labelKey="projectsLabel" description="Selected work will appear here." descriptionKey="projectsHint" />
    <div class="project-list">{featuredProjects.map((project, index) => <ProjectCard project={project} index={index} />)}</div>
    <a class="text-link" href="/projects"><span data-i18n="viewAllProjects">View all projects</span> <span aria-hidden="true">→</span></a>
  </section>

  <section class="section container stack-section" data-reveal>
    <SectionHeading index="04" label="Tech stack" labelKey="stackLabel" />
    <div class="stack-groups">
      {techStack.map((group) => (
        <div class="stack-group">
          <p data-translate-en={group.label} data-translate-zh={group.labelZh}>{group.label}</p>
          <ul class="tag-list stack-list">{group.items.map((technology) => <li>{technology}</li>)}</ul>
        </div>
      ))}
    </div>
  </section>

  <section id="writing" class="section container posts-section" data-reveal>
    <SectionHeading index="05" label="Latest posts" labelKey="postsLabel" description="Thoughts and notes, soon." descriptionKey="postsHint" />
    <div class="post-list">
      {latestPosts.map((post) => <article class="post-item"><p data-localized-date={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('en', { year: 'numeric', month: 'short', day: 'numeric' })}</p><h3><a href={`/blog/${post.id}`} data-translate-en={post.data.title} data-translate-zh={post.data.titleZh}>{post.data.title}</a></h3><a href={`/blog/${post.id}`} aria-label={`Read ${post.data.title}`}>↗</a></article>)}
    </div>
    <a class="text-link" href="/blog"><span data-i18n="viewAllPosts">View all posts</span> <span aria-hidden="true">→</span></a>
  </section>
</BaseLayout>
